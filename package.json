{
  "name": "requo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "tsx": {
      "esbuild": "0.27.2"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:inngest\"",
    "dev:check": "tsx scripts/dev-health-check.ts",
    "dev:app": "tsx scripts/dev-health-check.ts && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "dev:inngest": "npx inngest-cli@latest dev",
    "dev:ngrok": "tsx scripts/dev-tunnel.ts",
    "dev:tunnel": "concurrently \"npm run dev:app\" \"npm run dev:inngest\" \"npm run dev:ngrok\"",
    "dev:docker": "docker compose up --build",
    "dev:docker:tunnel": "docker compose --profile tunnel up --build",
    "build": "next build",
    "vercel-build": "npm run db:migrate:strict && next build",
    "start": "next start",
    "start:app": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:loading-coverage": "tsx scripts/audit-loading-coverage.ts",
    "audit:image-priority": "tsx scripts/audit-image-priority.ts",
    "audit:metadata-uniqueness": "tsx scripts/audit-metadata-uniqueness.ts",
    "audit:use-cache-purity": "tsx scripts/audit-use-cache-purity.ts",
    "audit:image-usage": "tsx scripts/audit-image-usage.ts",
    "audit:use-client-placement": "tsx scripts/audit-use-client-placement.ts",
    "audit:next-dynamic-comments": "tsx scripts/audit-next-dynamic-comments.ts",
    "audit:tenant-boundary": "tsx scripts/audit-tenant-boundary.ts",
    "audit:feature-boundaries": "tsx scripts/audit-feature-boundaries.ts",
    "audit:migrations": "tsx scripts/audit-migration-history.ts",
    "audit:instant-navigation": "tsx scripts/audit-instant-navigation.ts",
    "audit:density": "tsx scripts/audit-density.ts",
    "audit:radius": "tsx scripts/audit-radius.ts",
    "audit:status-tokens": "tsx scripts/audit-status-tokens.ts",
    "support:csv": "tsx scripts/generate-support-knowledge-csv.ts",
    "check:seo": "node scripts/test/run-sequential.mjs audit:loading-coverage audit:image-priority audit:metadata-uniqueness audit:use-cache-purity audit:image-usage audit:use-client-placement audit:next-dynamic-comments audit:tenant-boundary audit:instant-navigation audit:density audit:radius audit:status-tokens",
    "check:models": "tsx --conditions=react-server scripts/check-model-catalog.ts",
    "check:models:probe": "tsx --conditions=react-server scripts/check-model-catalog.ts --probe",
    "check:hydration": "node scripts/check-hydration.mjs",
    "check": "node scripts/test/run-sequential.mjs lint typecheck check:seo audit:feature-boundaries audit:migrations check:models",
    "test:unit": "vitest run tests/unit/",
    "test:components": "vitest run tests/components/",
    "test:e2e": "npm run test:e2e:full",
    "test:e2e:smoke": "node scripts/test/check-db.mjs --if-local && playwright test --grep \"@smoke\"",
    "test:e2e:full": "playwright test",
    "screenshots": "node scripts/marketing/capture-readme-screenshots.mjs",
    "screenshots:fallback": "playwright test --config playwright.screenshots.config.ts",
    "screenshots:analytics": "node scripts/analytics-screenshots.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:migrate:strict": "tsx --conditions=react-server scripts/migrate.ts --strict",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill-rollups": "tsx --conditions=react-server scripts/backfill-analytics-rollups.ts",
    "db:seed-demo": "tsx --conditions=react-server scripts/seed.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:local:setup": "npm run db:migrate && npm run db:seed && tsx scripts/apply-local-realtime-policies.ts",
    "db:seed-prod": "tsx --conditions=react-server scripts/seed-prod.ts",
    "test": "node scripts/test/run-sequential.mjs test:unit test:components",
    "test:integration": "node scripts/test/check-db.mjs && npm run db:migrate && vitest run tests/integration/ -c vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:coverage": "vitest run tests/unit/ tests/components/ --coverage && node scripts/test/check-coverage-outputs.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/provider": "^3.0.16",
    "@ai-sdk/react": "^3.0.279",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@file-type/cfbf": "^0.2.2",
    "@internationalized/date": "^3.12.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@polar-sh/nextjs": "1.1.0",
    "@polar-sh/sdk": "1.0.2",
    "@remixicon/react": "^4.9.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.101.1",
    "@thesvg/react": "^2.1.3",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.184",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-to-currency": "^2.0.3",
    "crisp-sdk-web": "^1.1.2",
    "currency-codes": "^2.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.2.0",
    "html-to-image": "^1.11.13",
    "i18n-iso-countries": "^7.14.0",
    "inngest": "^4.4.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.3",
    "motion": "^12.40.0",
    "nanoid": "^6.0.1",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.8",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-aria-components": "^1.21.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.3",
    "@next/playwright": "^16.3.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "fast-check": "^4.6.0",
    "jsdom": "^29.0.2",
    "ngrok": "^5.0.0-beta.2",
    "pg": "^8.20.0",
    "shadcn": "^4.1.2",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
