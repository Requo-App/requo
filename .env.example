
# Database
# Cloud Supabase (default): DATABASE_URL uses the pooler (6543) for
# app/runtime traffic; DATABASE_MIGRATION_URL uses the direct connection
# (5432) for Drizzle migrations. Keep the host, username, password, and
# database the same. Only the port changes. See docs/setup/local.md.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres

# Full local (Supabase CLI + Docker): replace both values above with the
# local stack's Postgres port after `npx supabase start`.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
# Optional explicit browser override. Same-origin setups can usually leave this unset.
NEXT_PUBLIC_BETTER_AUTH_URL=
# Optional dedicated HMAC secret for hashing opaque lookup tokens. Falls back to BETTER_AUTH_SECRET if unset.
APP_TOKEN_HASH_SECRET=
# Internal admin allowlist. Used by scripts/bootstrap-admin.ts to promote users
# to role = "admin", and as a runtime fallback in the admin access gate.
# Admin access itself is role-based (user.role = "admin") at `/admin` via
# normal Requo login.
ADMIN_EMAILS=
# Optional deployment host hint. Vercel usually provides this automatically.
VERCEL_URL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Search Console HTML tag verification (content value only).
GOOGLE_SITE_VERIFICATION=
# These credentials are also used for Google Calendar integration.
# If using Calendar, add calendar.events and calendar.readonly scopes in Google Cloud Console
# and add {BETTER_AUTH_URL}/api/google-calendar/callback as an authorized redirect URI.

# Supabase
# Cloud values come from the project dashboard (Settings > API). Full local
# values come from `npx supabase status` (URL http://127.0.0.1:54321 plus the
# printed anon/service-role keys and JWT secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
# Required for dashboard notification realtime subscriptions when using Better Auth.
# In Supabase, this is the project JWT secret under Settings > API.
SUPABASE_JWT_SECRET=

# Web Push notifications (optional)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email delivery
# Fallback order: Resend -> Mailtrap -> Brevo.
# All sending domains must be verified with each configured provider.
# For a small deployment, keep only one provider configured.
RESEND_API_KEY=
MAILTRAP_API_TOKEN=
BREVO_API_KEY=
# Low-email mode for limited/free provider quotas. When "1", optional
# operational emails are disabled at the feature/job boundary while required
# auth email (verification, password reset) and explicit owner-requested quote
# delivery keep working. See docs/setup/deployment.md (Low-email deployments).
# Do NOT use DISABLE_TRANSACTIONAL_EMAILS=1 for this — it skips auth email
# callbacks and can break verification, password reset, and magic-link flows.
# Test/seed-only kill-switch for transactional auth emails. Never set in
# production or preview deployments.
# DISABLE_TRANSACTIONAL_EMAILS=
LOW_EMAIL_MODE=
# Independently disable passwordless magic-link login email without affecting
# password login, verification, or password reset. Set to "1" to hide the
# magic-link UI and skip magic-link sends.
DISABLE_MAGIC_LINK=
EMAIL_DOMAIN=test.requo.app
EMAIL_FROM_DEFAULT="Requo Notifications <notifications@test.requo.app>"
EMAIL_FROM_NOTIFICATIONS="Requo Notifications <notifications@test.requo.app>"
EMAIL_FROM_SYSTEM="Requo System <system@test.requo.app>"
EMAIL_FROM_QUOTES="Requo Quotes <quotes@test.requo.app>"
EMAIL_FROM_SUPPORT="Requo Support <support@test.requo.app>"
# Legacy fallback. Prefer EMAIL_FROM_* values for new setup.
RESEND_FROM_EMAIL=
# RESEND_REPLY_TO_EMAIL can be your normal inbox where replies should land.
RESEND_REPLY_TO_EMAIL=support@test.requo.app
# Crisp website chat widget (optional)
# Used on marketing/public routes and the dashboard Support settings page actions.
CRISP_WEBSITE_ID=

# AI Providers (fallback order: Groq → Cerebras → Gemini → Mistral → Cloudflare → NVIDIA NIM → OpenRouter)
# Configure at least one. The router tries each configured provider in order,
# with multiple model fallbacks per provider. See lib/ai/model-options.ts for model lists.
# More providers configured = higher effective rate limit for your users.
GROQ_API_KEY=

# AI Security — canary token secret for system prompt leak detection.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Falls back to a hardcoded dev default if unset.
AI_CANARY_SECRET=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Mistral (https://console.mistral.ai/) — 1B tokens/month free tier, requires phone verification
MISTRAL_API_KEY=
# Cloudflare Workers AI (https://dash.cloudflare.com/) — 10,000 neurons/day free tier
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# NVIDIA NIM (https://build.nvidia.com) — 1000 free credits on signup, OpenAI-compatible
# Models: Nemotron Ultra 253B, Super 49B, Nano 8B + embedding models
NVIDIA_NIM_API_KEY=
# Conservative TPM budgets used by routing. The router uses 80% of each value
# and keeps 20% as headroom (see lib/ai/token-budget.ts RESERVED_HEADROOM).
# Override these with the limits shown in each provider dashboard.
AI_TPM_GROQ=8000
AI_TPM_CEREBRAS=30000
AI_TPM_GEMINI=250000
AI_TPM_MISTRAL=500000
AI_TPM_CLOUDFLARE=10000
AI_TPM_NVIDIA=20000
AI_TPM_OPENROUTER=20000
# Per-minute / per-day request and per-day token overrides (same pattern).
# 0 = not published / not modelled. Examples:
# AI_RPM_CEREBRAS=5
# AI_RPD_GROQ=1000
# AI_TPD_GROQ=200000
# AI_RPD_OPENROUTER=50
# OPENROUTER_DAILY_REQUESTS=50
# Daily neuron pool for Cloudflare Workers AI (default 10000, resets 00:00 UTC):
# AI_NEURONS_CLOUDFLARE_DAILY=10000
# CLOUDFLARE_DAILY_NEURONS=10000

# Polar (https://docs.polar.sh)
# Create products in the Polar dashboard, copy their product IDs below, and
# configure a webhook endpoint pointing to {NEXT_PUBLIC_APP_URL}/api/billing/polar/webhook.
# POLAR_SERVER must be "sandbox" (default) for the sandbox dashboard or
# "production" for live charges.
#
# Sandbox first: develop and validate end-to-end against the sandbox
# dashboard. Cut over to production only after the sandbox flow has been
# verified — see docs/setup/billing.md (Production cutover) for the full
# checklist (creating production products, the production webhook
# endpoint, the production access token, env replacement order, and
# post-deploy verification).
#
# `POLAR_ACCESS_TOKEN` and `POLAR_WEBHOOK_SECRET` must come from the same
# dashboard as `POLAR_SERVER` — mixing sandbox tokens with
# `POLAR_SERVER=production` (or vice versa) silently fails at request
# time. Subscribe the webhook to:
#   subscription.created, subscription.active, subscription.updated,
#   subscription.canceled, subscription.uncanceled, subscription.revoked,
#   order.paid, order.updated, order.refunded
# Refunds happen in the Polar customer portal and reach Requo via
# subscription.canceled / subscription.revoked events; refund.* event
# subscriptions are not required.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Product ids for the current pricing. New checkouts always resolve here.
POLAR_PRO_PRODUCT_ID=
POLAR_BUSINESS_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
POLAR_BUSINESS_YEARLY_PRODUCT_ID=
# Optional legacy product ids used before the current pricing. Only used
# for webhook reverse-resolution so active subscriptions keep resolving
# after the product ids are swapped. Not used for new checkouts.
POLAR_LEGACY_PRO_PRODUCT_ID=
POLAR_LEGACY_BUSINESS_PRODUCT_ID=
POLAR_LEGACY_PRO_YEARLY_PRODUCT_ID=
POLAR_LEGACY_BUSINESS_YEARLY_PRODUCT_ID=
# Public app origin used to build Polar hosted checkout success/cancel URLs.
# Example: http://localhost:3000 in dev, https://requo.app in production.
NEXT_PUBLIC_APP_URL=

# Optional demo seed overrides
DEMO_OWNER_NAME=Morgan Lee
DEMO_OWNER_EMAIL=demo@requo.local
DEMO_OWNER_PASSWORD=ChangeMe123456!
DEMO_BUSINESS_NAME=BrightSide Print Studio
DEMO_BUSINESS_SLUG=brightside-print-studio
# Optional test/demo URL token overrides used by the demo seed and Playwright fixtures.
DEMO_QUOTE_PUBLIC_TOKEN=demoquote1002senttoken
DEMO_EXPIRED_QUOTE_PUBLIC_TOKEN=demoquote1005expiredtoken
DEMO_VOIDED_QUOTE_PUBLIC_TOKEN=demoquote1006voidedtoken

# Inngest background jobs / cron schedules
# Local dev:
# - run `npm run dev:inngest`
# - set INNGEST_DEV=1 so events route to the local Inngest Dev Server (http://localhost:8288)
# Production:
# - set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from your Inngest Cloud app
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Cron
# Secret used to authenticate Vercel Cron requests to /api/cron/* endpoints.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# In production, Vercel automatically sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Upstash Redis (distributed cache for AI rate limiting, cooldowns, and response caching)
# Create a database at https://console.upstash.com and copy the REST API credentials.
# Optional in dev — falls back to in-memory cache when missing.
# WARNING: Never commit live credentials. Rotate immediately if a real token was ever committed here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
