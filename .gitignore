# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/screenshots/
# tests/screenshots/ is tracked: `npm run screenshots`
# (native Windows capture) regenerates the README assets in
# public/screenshots/ from seed data; `npm run screenshots:fallback` is the
# portable Playwright path.
# Generated test reports — regenerated on every run, and Playwright's JSON reporter even
# serializes process.env (secrets) into its metadata. Never track them.
/reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor (never commit local editor/IDE state)
.vscode
.idea
.cursor
.opencode
.windsurf
.zed

# local AI tooling workspaces
.kilo/
.kiro/

# Remotion video project
/requo-video/

# Claude Code skills junction -> .agents/skills (avoid tracking a second copy)
.claude/skills
.claude/settings.local.json

# Local agent state (Freebuff)
.freebuff/
.workbuddy-ai/

# Landing walkthrough recordings (scripts/marketing/record-landing-walkthrough.mjs)
.walkthrough/
